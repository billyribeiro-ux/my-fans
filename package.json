{
  "name": "myfans",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @myfans/web dev",
    "dev:api": "cargo run -p myfans-api",
    "build": "pnpm --filter @myfans/web build",
    "check": "pnpm --filter @myfans/web check",
    "test": "pnpm --filter @myfans/web test",
    "test:e2e": "pnpm --filter @myfans/web test:e2e",
    "test:api": "cargo test --workspace --locked",
    "test:db": "bash scripts/test-db.sh",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "db:start": "docker compose up -d --wait",
    "db:seed": "cargo run --locked -p myfans-api -- seed",
    "test:integration": "bash scripts/test-integration.sh",
    "deploy:private": "node scripts/deploy-private.mjs",
    "package:private": "node scripts/package-private.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1"
  }
}
