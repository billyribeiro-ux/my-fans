# Isolated provider TEST environment only. These are placeholders, never credentials.
# Use a fresh database; do not seed fixture accounts or reuse a local sandbox database.
APP_MODE=sandbox
CONTENT_POLICY=general
APP_RUN_MIGRATIONS=false
DATABASE_URL_FILE=/run/secrets/database_url
PUBLIC_ORIGIN=https://replace-with-your-test-domain.example
MFA_ENCRYPTION_KEY_FILE=/run/secrets/mfa_encryption_key
MEDIA_ROOT=/app/.local/media

PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY_FILE=/run/secrets/stripe_test_key
STRIPE_WEBHOOK_SECRET_FILE=/run/secrets/stripe_webhook_secret
# Actual launch-country code accepted for your connected accounts; no default jurisdiction.
STRIPE_ACCOUNT_COUNTRY=REPLACE

IDENTITY_PROVIDER=sumsub
SUMSUB_MODE=test
SUMSUB_CLIENT_ID=replace-with-your-client-id
SUMSUB_LEVEL=creator-18
SUMSUB_APP_TOKEN_FILE=/run/secrets/sumsub_app_token
SUMSUB_SECRET_KEY_FILE=/run/secrets/sumsub_secret_key
SUMSUB_WEBHOOK_SECRET_FILE=/run/secrets/sumsub_webhook_secret

MEDIA_STORAGE=s3
AWS_REGION=us-east-1
S3_BUCKET=replace-with-private-bucket
S3_EXPECTED_BUCKET_OWNER=REPLACE_WITH_12_DIGITS
S3_PREFIX=myfans/
# Set S3_KMS_KEY_ID to the managed KMS key ARN when using SSE-KMS.
# Credentials come from the AWS SDK workload identity chain, never from this file.

MEDIA_SCANNER=clamav
CLAMAV_ADDRESS=127.0.0.1:3310
# ClamAV must share the app's network namespace and run with TZ=UTC.

MAIL_TRANSPORT=smtp
SMTP_HOST=replace-with-approved-smtp-host.example
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD_FILE=/run/secrets/smtp_password
MAIL_FROM=replace-with-verified-sender@example.com
MAIL_PUBLIC_ORIGIN=https://replace-with-your-test-domain.example
