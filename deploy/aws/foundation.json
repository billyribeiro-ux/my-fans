    "DatabaseAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Apply the tier-specific route table."
        }
      },
      "Properties": {
        "SubnetId": {
          "Ref": "DatabaseSubnet1"
        },
        "RouteTableId": {
          "Ref": "DatabaseRoutes1"
        }
      }
    },
    "NatAddress1": {
      "Type": "AWS::EC2::EIP",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Dedicated AZ-local NAT egress address."
        }
      },
      "Properties": {
        "Domain": "vpc"
      }
    },
    "Nat1": {
      "Type": "AWS::EC2::NatGateway",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Avoid a single-AZ egress dependency."
        }
      },
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": ["NatAddress1", "AllocationId"]
        },
        "SubnetId": {
          "Ref": "PublicSubnet1"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "PublicDefault1": {
      "Type": "AWS::EC2::Route",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Internet route only for NAT subnets."
        }
      },
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRoutes1"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "PrivateDefault1": {
      "Type": "AWS::EC2::Route",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Application egress uses its own AZ NAT."
        }
      },
      "Properties": {
        "RouteTableId": {
          "Ref": "PrivateRoutes1"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "Nat1"
        }
      }
    },
    "PublicSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "AZ-separated networking; only NAT gateways occupy public subnets."
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Ref": "AvailabilityZones"
            }
          ]
        },
        "CidrBlock": "10.64.1.0/24",
        "MapPublicIpOnLaunch": false
      }
    },
    "PublicRoutes2": {
      "Type": "AWS::EC2::RouteTable",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Separate egress and isolated database routing."
        }
      },
      "Properties": {
