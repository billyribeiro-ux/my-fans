    },
    "DatabaseSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "AZ-separated networking; only NAT gateways occupy public subnets."
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Ref": "AvailabilityZones"
            }
          ]
        },
        "CidrBlock": "10.64.32.0/24",
        "MapPublicIpOnLaunch": false
      }
    },
    "DatabaseRoutes1": {
      "Type": "AWS::EC2::RouteTable",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Separate egress and isolated database routing."
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
