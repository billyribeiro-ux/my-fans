{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private two-AZ Fargate network, PostgreSQL HA with retained encrypted backups, generated secrets, and authenticated SES feedback.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    },
    "com.aws.cloudformation.Context": {
      "arch": "Three staged stacks: foundation, runtime with service counts initially zero, private edge. Account us-east-1 required.",
      "must": [
        "Migrate and verify before increasing service counts.",
        "Preserve all encryption keys and secrets with data."
      ],
      "ref": [
        {
          "at": "docs/aws-runtime.md",
          "has": "Deployment and recovery contracts."
        }
      ]
    }
  },
  "Parameters": {
    "DeploymentName": {
      "Type": "String",
      "AllowedPattern": "^[a-z][a-z0-9-]{2,19}$"
    },
    "DbInstanceClass": {
      "Type": "String",
      "Default": "db.r8g.large",
      "AllowedPattern": "^db\\.[a-z0-9]+\\.[a-z0-9]+$"
    },
    "CloudFrontPrefixListId": {
      "Type": "String",
      "AllowedPattern": "^pl-[a-f0-9]+$"
    },
    "AlarmEmail": {
      "Type": "String",
      "AllowedPattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "Description": "Operator mailbox; confirm the SNS subscription before launch."
    },
    "AvailabilityZones": {
      "Type": "List<AWS::EC2::AvailabilityZone::Name>"
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Dedicated isolated address space; application and database have no public IPs."
        }
      },
      "Properties": {
        "CidrBlock": "10.64.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Ref": "DeploymentName"
            }
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "NAT egress for provider HTTPS, authenticated SMTP and signature updates."
        }
      },
      "Properties": {}
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "CloudFront VPC origins require an internet gateway but use private origins."
        }
      },
      "Properties": {
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        },
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "PublicSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "AZ-separated networking; only NAT gateways occupy public subnets."
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Ref": "AvailabilityZones"
            }
          ]
        },
        "CidrBlock": "10.64.0.0/24",
        "MapPublicIpOnLaunch": false
      }
    },
    "PublicRoutes1": {
      "Type": "AWS::EC2::RouteTable",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Separate egress and isolated database routing."
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "PublicAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Apply the tier-specific route table."
        }
      },
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnet1"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes1"
        }
      }
    },
    "PrivateSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "AZ-separated networking; only NAT gateways occupy public subnets."
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Ref": "AvailabilityZones"
            }
          ]
        },
        "CidrBlock": "10.64.16.0/24",
        "MapPublicIpOnLaunch": false
      }
    },
    "PrivateRoutes1": {
      "Type": "AWS::EC2::RouteTable",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Separate egress and isolated database routing."
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "PrivateAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Apply the tier-specific route table."
        }
      },
      "Properties": {
        "SubnetId": {
          "Ref": "PrivateSubnet1"
        },
        "RouteTableId": {
          "Ref": "PrivateRoutes1"
        }
