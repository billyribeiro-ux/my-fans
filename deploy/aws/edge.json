{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudFront private VPC origin with TLS, disabled application caching, WAF rate and managed rules, and DNS-validated public domain.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    },
    "com.aws.cloudformation.Context": {
      "arch": "Three staged stacks: foundation, runtime with service counts initially zero, private edge. Account us-east-1 required.",
      "must": [
        "Migrate and verify before increasing service counts.",
        "Preserve all encryption keys and secrets with data."
      ],
      "ref": [
        {
          "at": "docs/aws-runtime.md",
          "has": "Deployment and recovery contracts."
        }
      ]
    }
  },
  "Parameters": {
    "DeploymentName": {
      "Type": "String"
    },
    "LoadBalancerArn": {
      "Type": "String"
    },
    "OriginDomainName": {
      "Type": "String"
    },
    "HostedZoneId": {
      "Type": "String"
    },
    "DomainName": {
      "Type": "String"
    },
    "AlarmTopicArn": {
      "Type": "String"
    },
    "DataKeyArn": {
      "Type": "String"
    }
  },
  "Resources": {
    "ViewerCertificate": {
      "Type": "AWS::CertificateManager::Certificate",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Same us-east-1 stack owns the certificate required by CloudFront."
        }
      },
      "Properties": {
        "DomainName": {
          "Ref": "DomainName"
        },
        "ValidationMethod": "DNS",
        "DomainValidationOptions": [
          {
            "DomainName": {
              "Ref": "DomainName"
            },
            "HostedZoneId": {
              "Ref": "HostedZoneId"
            }
          }
        ]
      }
    },
    "VpcOrigin": {
      "Type": "AWS::CloudFront::VpcOrigin",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "CloudFront reaches an internal ALB; no internet-facing origin or shared-header bypass.",
          "must": ["Selected AZs must support VPC origins; preflight excludes use1-az3."]
        }
      },
      "Properties": {
        "VpcOriginEndpointConfig": {
          "Arn": {
            "Ref": "LoadBalancerArn"
          },
          "Name": {
            "Fn::Sub": "${DeploymentName}-private-origin"
          },
          "HTTPPort": 80,
          "HTTPSPort": 443,
          "OriginProtocolPolicy": "https-only",
          "OriginSSLProtocols": ["TLSv1.2"]
        }
      }
    },
    "WebAcl": {
      "Type": "AWS::WAFv2::WebACL",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Rate limits and maintained AWS rules supplement route authorization; payload bytes are bounded in the application.",
          "must": [
            "Body size managed rule counts uploads; app enforces 10 MiB upload and 256 KiB webhook limits.",
            "Sampled requests disabled to avoid retaining authorization and private bodies."
          ]
        }
      },
      "Properties": {
        "Scope": "CLOUDFRONT",
        "DefaultAction": {
          "Allow": {}
        },
        "VisibilityConfig": {
          "SampledRequestsEnabled": false,
          "CloudWatchMetricsEnabled": true,
          "MetricName": "WebAcl"
        },
        "Rules": [
          {
            "Name": "PerClientRate",
            "Priority": 0,
            "Action": {
              "Block": {}
            },
            "Statement": {
              "RateBasedStatement": {
                "Limit": 1200,
                "AggregateKeyType": "IP",
                "EvaluationWindowSec": 300
              }
            },
            "VisibilityConfig": {
              "SampledRequestsEnabled": false,
              "CloudWatchMetricsEnabled": true,
              "MetricName": "PerClientRate"
            }
          },
          {
            "Name": "AWSManagedRulesAmazonIpReputationList",
            "Priority": 1,
            "OverrideAction": {
              "None": {}
            },
            "Statement": {
              "ManagedRuleGroupStatement": {
                "VendorName": "AWS",
                "Name": "AWSManagedRulesAmazonIpReputationList"
              }
            },
            "VisibilityConfig": {
              "SampledRequestsEnabled": false,
              "CloudWatchMetricsEnabled": true,
              "MetricName": "AWSManagedRulesAmazonIpReputationList"
            }
          },
          {
            "Name": "AWSManagedRulesKnownBadInputsRuleSet",
            "Priority": 2,
            "OverrideAction": {
              "None": {}
            },
            "Statement": {
              "ManagedRuleGroupStatement": {
                "VendorName": "AWS",
                "Name": "AWSManagedRulesKnownBadInputsRuleSet"
              }
            },
            "VisibilityConfig": {
              "SampledRequestsEnabled": false,
              "CloudWatchMetricsEnabled": true,
              "MetricName": "AWSManagedRulesKnownBadInputsRuleSet"
            }
          },
          {
            "Name": "AWSManagedRulesCommonRuleSet",
            "Priority": 3,
            "OverrideAction": {
              "None": {}
            },
            "Statement": {
              "ManagedRuleGroupStatement": {
                "VendorName": "AWS",
                "Name": "AWSManagedRulesCommonRuleSet",
                "RuleActionOverrides": [
                  {
                    "Name": "SizeRestrictions_BODY",
                    "ActionToUse": {
                      "Count": {}
                    }
                  }
                ]
              }
            },
            "VisibilityConfig": {
              "SampledRequestsEnabled": false,
              "CloudWatchMetricsEnabled": true,
              "MetricName": "AWSManagedRulesCommonRuleSet"
            }
          }
        ]
      }
    },
    "WafLogKey": {
      "Type": "AWS::KMS::Key",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Independent encrypted WAF incident logs with retained key."
        }
      },
      "Properties": {
        "EnableKeyRotation": true,
        "PendingWindowInDays": 30,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"
                }
              },
              "Action": "kms:*",
              "Resource": "*"
            },
            {
              "Effect": "Allow",
              "Principal": {
                "Service": {
                  "Fn::Sub": "logs.${AWS::Region}.${AWS::URLSuffix}"
                }
              },
              "Action": [
                "kms:Encrypt",
                "kms:Decrypt",
                "kms:ReEncrypt*",
                "kms:GenerateDataKey*",
                "kms:DescribeKey"
              ],
              "Resource": "*",
              "Condition": {
                "ArnEquals": {
                  "kms:EncryptionContext:aws:logs:arn": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:aws-waf-logs-${DeploymentName}"
                  }
                }
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "WafLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Only blocked requests are retained; sensitive header and query values redacted."
        }
      },
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "aws-waf-logs-${DeploymentName}"
        },
        "RetentionInDays": 90,
        "KmsKeyId": {
          "Fn::GetAtt": ["WafLogKey", "Arn"]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "WafLogging": {
      "Type": "AWS::WAFv2::LoggingConfiguration",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Preserve blocked-event evidence without cookies, webhook signatures or token query strings."
        }
      },
      "Properties": {
        "ResourceArn": {
          "Fn::GetAtt": ["WebAcl", "Arn"]
        },
        "LogDestinationConfigs": [
          {
            "Fn::GetAtt": ["WafLogs", "Arn"]
          }
        ],
        "RedactedFields": [
          {
            "SingleHeader": {
              "Name": "authorization"
            }
          },
          {
            "SingleHeader": {
              "Name": "cookie"
            }
          },
          {
            "SingleHeader": {
              "Name": "stripe-signature"
            }
          },
          {
            "SingleHeader": {
              "Name": "x-payload-digest"
            }
          },
          {
            "QueryString": {}
          }
        ],
        "LoggingFilter": {
          "DefaultBehavior": "DROP",
          "Filters": [
            {
              "Behavior": "KEEP",
              "Requirement": "MEETS_ANY",
              "Conditions": [
                {
                  "ActionCondition": {
                    "Action": "BLOCK"
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Every authorized response reaches the app; all cookies, queries and signature headers forwarded except Host.",
          "must": [
            "No cached private media, checkout, sessions or error responses.",
            "ORIGIN is fixed to the viewer domain in the application; origin TLS matches origin domain."
          ]
        }
      },
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Aliases": [
            {
              "Ref": "DomainName"
            }
          ],
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "WebACLId": {
            "Fn::GetAtt": ["WebAcl", "Arn"]
          },
          "Origins": [
            {
              "Id": "private-app",
              "DomainName": {
                "Ref": "OriginDomainName"
              },
              "VpcOriginConfig": {
                "VpcOriginId": {
                  "Fn::GetAtt": ["VpcOrigin", "Id"]
                },
                "OriginReadTimeout": 60,
                "OriginKeepaliveTimeout": 5
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "private-app",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": ["GET", "HEAD", "OPTIONS", "PUT", "PATCH", "POST", "DELETE"],
            "CachedMethods": ["GET", "HEAD"],
            "Compress": true,
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
            "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
            "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03"
          },
          "ViewerCertificate": {
            "AcmCertificateArn": {
              "Ref": "ViewerCertificate"
            },
            "SslSupportMethod": "sni-only",
            "MinimumProtocolVersion": "TLSv1.2_2021"
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 400,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 403,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 404,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 405,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 414,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 416,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 500,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 501,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 502,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 503,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 504,
              "ErrorCachingMinTTL": 0
            }
          ]
        }
      }
    },
    "ViewerDnsA": {
      "Type": "AWS::Route53::RecordSet",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Public application domain points only to CloudFront."
        }
      },
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": {
          "Ref": "DomainName"
        },
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": ["Distribution", "DomainName"]
          },
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "EvaluateTargetHealth": false
        }
      }
    },
    "ViewerDnsAAAA": {
      "Type": "AWS::Route53::RecordSet",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Public application domain points only to CloudFront."
        }
      },
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": {
          "Ref": "DomainName"
        },
        "Type": "AAAA",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": ["Distribution", "DomainName"]
          },
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "EvaluateTargetHealth": false
        }
      }
    },
    "EdgeErrors": {
      "Type": "AWS::CloudWatch::Alarm",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Alert on persistent edge or origin failure."
        }
      },
      "Properties": {
        "Namespace": "AWS/CloudFront",
        "MetricName": "5xxErrorRate",
        "Dimensions": [
          {
            "Name": "DistributionId",
            "Value": {
              "Ref": "Distribution"
            }
          },
          {
            "Name": "Region",
            "Value": "Global"
          }
        ],
        "Statistic": "Average",
        "Period": 60,
        "EvaluationPeriods": 3,
        "Threshold": 5,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "AlarmTopicArn"
          }
        ]
      }
    },
    "EdgeLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Selected CloudFront telemetry avoids storing email-action query tokens or cookies."
        }
      },
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/myfans/${DeploymentName}/edge"
        },
        "RetentionInDays": 90,
        "KmsKeyId": {
          "Ref": "DataKeyArn"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "EdgeLogSource": {
      "Type": "AWS::Logs::DeliverySource",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "CloudFront standard logging v2 permits a privacy-minimized field list."
        }
      },
      "Properties": {
        "Name": {
          "Fn::Sub": "${DeploymentName}-edge"
        },
        "ResourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
        },
        "LogType": "ACCESS_LOGS"
      }
    },
    "EdgeLogDestination": {
      "Type": "AWS::Logs::DeliveryDestination",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Encrypted CloudWatch destination, accessible only through IAM."
        }
      },
      "Properties": {
        "Name": {
          "Fn::Sub": "${DeploymentName}-edge"
        },
        "DestinationResourceArn": {
          "Fn::GetAtt": ["EdgeLogs", "Arn"]
        },
        "OutputFormat": "json"
      }
    },
    "EdgeLogDelivery": {
      "Type": "AWS::Logs::Delivery",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "No cookies, request headers, query strings or referer values in retained access evidence."
        }
      },
      "Properties": {
        "DeliverySourceName": {
          "Ref": "EdgeLogSource"
        },
        "DeliveryDestinationArn": {
          "Fn::GetAtt": ["EdgeLogDestination", "Arn"]
        },
        "RecordFields": [
          "date",
          "time",
          "x-edge-location",
          "cs-method",
          "cs-uri-stem",
          "sc-status",
          "x-edge-result-type",
          "x-edge-request-id",
          "time-taken",
          "ssl-protocol",
          "time-to-first-byte"
        ]
      }
    }
  },
  "Outputs": {
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      },
      "Description": "Edge runtime identity."
    },
    "ApplicationOrigin": {
      "Value": {
        "Fn::Sub": "https://${DomainName}"
      },
      "Description": "Edge runtime identity."
    },
    "WafArn": {
      "Value": {
        "Fn::GetAtt": ["WebAcl", "Arn"]
      },
      "Description": "Edge runtime identity."
    }
  }
}
